# Application
# 3002 avoids colliding with the frontend dev server (3000) and the backend
# API default (3001) when running `npm run dev:all` from the repo root.
PORT=3002
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=shop

# Copy to .env and fill in real values.
# Never commit .env to version control.
