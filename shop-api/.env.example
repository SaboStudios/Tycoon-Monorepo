# Application
# 3002 avoids colliding with the frontend dev server (3000) and the backend
# API default (3001) when running `npm run dev:all` from the repo root.
PORT=3002
NODE_ENV=development

# Authentication (POST /purchases)
# Provide at least one. The API key is sent by clients as `x-api-key`; the JWT
# secret enables `Authorization: Bearer <token>` verification.
# Rotate the API key by replacing SHOP_API_KEY in the environment and redeploying.
SHOP_API_KEY=
JWT_SECRET=

# Swagger / OpenAPI
# Swagger UI is served at /docs by default in non-production environments.
# Set to true to force it on in production.
ENABLE_SWAGGER=false

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=shop

# Copy to .env and fill in real values.
# Never commit .env to version control.
