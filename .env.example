# =============================================================================
# Tycoon environment example
# Copy to .env and adjust for your environment.
# =============================================================================

# --- Core ---
NODE_ENV=development
PORT=3000

# --- Database ---
DATABASE_URL=postgres://tycoon:tycoon@localhost:5432/tycoon

# --- Redis ---
REDIS_URL=redis://localhost:6379

# =============================================================================
# Local-only debug tooling
# =============================================================================
# PgAdmin and debug ports are LOCAL DEVELOPMENT ONLY.
# They are bound to 127.0.0.1 and must never be published in non-local
# (staging/production) Docker Compose profiles. Non-local profiles do not
# expose these ports at all; do not set them there.
#
# PgAdmin (local profile only)
PGADMIN_DEFAULT_EMAIL=admin@local.test
PGADMIN_DEFAULT_PASSWORD=local-only-change-me
PGADMIN_PORT=5050

# Node inspector / debug port (local profile only)
DEBUG_PORT=9229
