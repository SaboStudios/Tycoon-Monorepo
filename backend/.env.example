# Backend (NestJS) environment example — see docs/ENVIRONMENT.md for the
# authoritative table (required-in-prod, secret, and allowed values).
# Copy to backend/.env and fill in real values. Never commit backend/.env.
# Secrets are left blank here on purpose: an empty value fails boot checks,
# a placeholder can survive into production unnoticed.

# --- App ---
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_DEFAULT_VERSION=1
API_ENABLE_LEGACY_UNVERSIONED=true
API_LEGACY_UNVERSIONED_SUNSET=
ENABLE_SWAGGER=false

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=tycoon_db
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_POOL_SIZE=5
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=0
DB_CONNECT_TIMEOUT_MS=5000

# --- Auth / JWT ---
JWT_SECRET=
JWT_EXPIRATION_TIME=1d
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_CLOCK_SKEW_SECONDS=60

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400
CORS_DEV_WILDCARD=true
WS_CORS_ORIGINS=

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=300

# --- Logging & Observability ---
LOG_LEVEL=debug
LOG_CONSOLE=false
METRICS_ENABLED=true
REQUEST_LOGGING_ENABLED=true

# --- Payments & Webhooks ---
PAYMENT_WEBHOOK_SECRET=
PAYMENT_PROVIDER=stub
STRIPE_SECRET_KEY=
RECONCILIATION_DRY_RUN=false

# --- Data Export (Privacy) ---
DATA_EXPORT_DIR=./storage/data-exports
DATA_EXPORT_TTL_HOURS=24
DATA_EXPORT_ENABLED=true
DATA_EXPORT_STEP_UP_MAX_AGE_SECONDS=300
DATA_EXPORT_STEP_UP_METHODS=pwd,wallet
DATA_EXPORT_ENQUEUE_TIMEOUT_MS=5000

# --- Graceful Shutdown ---
SHUTDOWN_TIMEOUT_MS=15000

# --- Game Defaults ---
DEFAULT_AUCTION=true
DEFAULT_RENT_IN_PRISON=false
DEFAULT_MORTGAGE=true
DEFAULT_EVEN_BUILD=true
DEFAULT_RANDOMIZE_PLAY_ORDER=true
DEFAULT_STARTING_CASH=1500

# --- Audit ---
GAMES_AUDIT_ENABLED=true
GAMES_AUDIT_LOG_LEVEL=info
GAMES_AUDIT_REDACT_SENSITIVE=true
GAMES_AUDIT_LOG_VIEWS=false
GAMES_AUDIT_ASYNC_TIMEOUT_MS=5000
CACHE_AUDIT_ENABLED=false
UPLOADS_OBSERVABILITY_ENABLED=true

# --- Uploads & Storage ---
UPLOAD_MAX_FILE_SIZE_MB=5
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
UPLOAD_DIR=./storage/uploads
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_S3_ENDPOINT=
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Email ---
EMAIL_PROVIDER=noop
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Tycoon
SES_REGION=
SES_FROM_EMAIL=

# --- Feature Flags ---
FEATURE_STELLAR_ENABLED=false
FEATURE_NEAR_ENABLED=true
