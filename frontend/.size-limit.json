[
  {
    "name": "First Load JS (shared)",
    "kind": "shared",
    "limit": "120 kB"
  },
  {
    "name": "Main page JS",
    "kind": "route",
    "route": "/",
    "limit": "50 kB"
  },
  {
    "name": "Join room page JS",
    "kind": "route",
    "route": "/join-room",
    "limit": "50 kB"
  },
  {
    "name": "Total First Load JS (largest route)",
