# NEAR (optional; defaults to testnet + guest-book.testnet for wallet sign-in)
# NEXT_PUBLIC_NEAR_NETWORK=testnet
# NEXT_PUBLIC_NEAR_CONTRACT_ID=guest-book.testnet

# Live perks/boosts socket (Socket.IO client for the backend "boosts" namespace).
# Defaults to enabled; set to false to disable the realtime connection.
# NEXT_PUBLIC_ENABLE_BOOSTS_SOCKET=true
# Optional override for the socket endpoint (defaults to NEXT_PUBLIC_API_URL).
# NEXT_PUBLIC_SOCKET_URL=

