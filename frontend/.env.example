# NEAR — network and contract configuration
# Defaults to testnet when unset. Set to "mainnet" only for production deploys.
# NEXT_PUBLIC_NEAR_NETWORK=testnet
#
# Contract ID for wallet sign-in (function-call access key).
# Must match the network above:
#   testnet  → use a .testnet account  (e.g. myapp.testnet)
#   mainnet  → use a .near account     (e.g. myapp.near)
# Setting a mainnet ".near" ID while NEXT_PUBLIC_NEAR_NETWORK=testnet will throw
# at startup to prevent accidental real-money calls in dev builds.
# NEXT_PUBLIC_NEAR_CONTRACT_ID=myapp.testnet

# Backend API base URL.
# ⚠  In dev:all the backend runs on :3001 (not :3000) to avoid collision with
#    Next.js dev server. Set this before running `npm run dev:all`.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Live perks/boosts socket (Socket.IO client for the backend "boosts" namespace).
# Defaults to enabled; set to false to disable the realtime connection.
# NEXT_PUBLIC_ENABLE_BOOSTS_SOCKET=true
# Optional override for the socket endpoint (defaults to NEXT_PUBLIC_API_URL).
# NEXT_PUBLIC_SOCKET_URL=

