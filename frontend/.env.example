# Frontend (Next.js) environment example — see docs/ENVIRONMENT.md.
# Copy to frontend/.env.local. Every NEXT_PUBLIC_* value is inlined into the
# browser bundle, so nothing secret belongs in this file.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000
NEXT_PUBLIC_SHOP_API_URL=http://localhost:3002
NEXT_PUBLIC_GAME_WS_URL=ws://localhost:3000

# --- NEAR (the only supported chain UI per ADR-003) ---
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_CONTRACT_ID=

# --- Analytics & error tracking ---
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ANALYTICS_PROVIDERS=
NEXT_PUBLIC_ANALYTICS_DEBUG=false
NEXT_PUBLIC_ERROR_TRACKING_ENDPOINT=
